@page "/turnos"
@using MavisBelleza.Models
@using MavisBelleza.Services
@using MavisBelleza.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TurnoStateService TurnoState

<PageTitle>Listado de Turnos - Mavis Belleza</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold title-marca m-0">Gestión de Turnos</h2>
            <p class="text-muted small m-0">Consulta y administra las reservas agendadas en el studio</p>
        </div>
        <a href="/turnos/nuevo" class="btn btn-spa px-4 py-2">
            + Nuevo Turno
        </a>
    </div>

    @if (listadoTurnos == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="text-muted mt-2">Cargando turnos...</p>
        </div>
    }
    else if (!listadoTurnos.Any())
    {
        <div class="card card-spa text-center py-5 px-4">
            <h4 class="fw-bold title-marca">No hay turnos agendados por el momento</h4>
            <p class="text-muted">Haz clic en el botón superior para cargar el primer turno.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var turno in listadoTurnos)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <TurnoCard Turno="turno" OnDelete="EliminarTurno" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<TurnosModels>? listadoTurnos;

    protected override async Task OnInitializedAsync()
    {
        await CargarTurnos();
    }

    private async Task CargarTurnos()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        listadoTurnos = await db.Turnos.OrderBy(t => t.Fecha).ToListAsync();
    }

    private async Task EliminarTurno(int id)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var turno = await db.Turnos.FindAsync(id);
        if (turno != null)
        {
            db.Turnos.Remove(turno);
            await db.SaveChangesAsync();
            TurnoState.NotifyStateChanged();
            await CargarTurnos();
        }
    }
}