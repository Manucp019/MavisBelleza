@page "/turnos"
@using Microsoft.EntityFrameworkCore
@using MavisBelleza.Data
@using MavisBelleza.Models
@using MavisBelleza.Services
@using MavisBelleza.Components.Components_Reutilizables
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TurnoStateService StateService
@inject IJSRuntime JS

<PageTitle>Gestión de Turnos</PageTitle>

<main class="container my-4">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold" style="color: #2f3e46;">Gestión de Turnos</h1>
        <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: #a3b18a; color: #2f3e46;">
            Total en sistema: @StateService.TotalTurnos
        </span>
    </header>

    <div class="row mb-3">
        <div class="col-md-8">
            <Buscador OnSearchChanged="FiltrarTurnos" />
        </div>
    </div>

    @if (turnosPaginados == null)
    {
        <p>Cargando turnos...</p>
    }
    else if (!turnosPaginados.Any())
    {
        <div class="alert alert-info rounded-4 text-center">
            No se encontraron turnos agendados.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var turno in turnosPaginados)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <TurnoCard Turno="turno" OnDelete="SolicitarEliminacion" />
                </div>
            }
        </div>

        <div class="mt-4">
            <Paginador PaginaActual="paginaActual" TotalPaginas="totalPaginas" OnPageChanged="CambiarPagina" />
        </div>
    }
</main>

<ModalConfirm Mostrar="mostrarModal" OnResponse="ConfirmarEliminacion" />

@code {
    private List<TurnosModels> todosLosTurnos = new();
    private List<TurnosModels> turnosFiltrados = new();
    private List<TurnosModels> turnosPaginados = new();

    private string filtro = string.Empty;
    private int paginaActual = 1;
    private int tamanoPagina = 3;
    private int totalPaginas = 1;

    private bool mostrarModal = false;
    private int turnoIdAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarTurnos();
    }

    private async Task CargarTurnos()
    {
        using var context = DbFactory.CreateDbContext();
        todosLosTurnos = await context.Turnos.ToListAsync();
        StateService.ActualizarTotal(todosLosTurnos.Count);
        AplicarFiltroYPaginar();
    }

    private void FiltrarTurnos(string texto)
    {
        filtro = texto;
        paginaActual = 1;
        AplicarFiltroYPaginar();
    }

    private void AplicarFiltroYPaginar()
    {
        turnosFiltrados = string.IsNullOrWhiteSpace(filtro)
            ? todosLosTurnos
            : todosLosTurnos.Where(t =>
                t.NombreCliente.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                t.ApellidoCliente.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                t.Servicio.Contains(filtro, StringComparison.OrdinalIgnoreCase)).ToList();

        totalPaginas = (int)Math.Ceiling(turnosFiltrados.Count / (double)tamanoPagina);
        if (totalPaginas == 0) totalPaginas = 1;

        turnosPaginados = turnosFiltrados
            .Skip((paginaActual - 1) * tamanoPagina)
            .Take(tamanoPagina)
            .ToList();
    }

    private void CambiarPagina(int nuevaPagina)
    {
        paginaActual = nuevaPagina;
        AplicarFiltroYPaginar();
    }

    private void SolicitarEliminacion(int id)
    {
        turnoIdAEliminar = id;
        mostrarModal = true;
    }

    private async Task ConfirmarEliminacion(bool confirmado)
    {
        mostrarModal = false;
        if (confirmado)
        {
            using var context = DbFactory.CreateDbContext();
            var turno = await context.Turnos.FindAsync(turnoIdAEliminar);
            if (turno != null)
            {
                context.Turnos.Remove(turno);
                await context.SaveChangesAsync();

                await JS.InvokeVoidAsync("mostrarAlerta", "El turno fue eliminado exitosamente.");
                await CargarTurnos();
            }
        }
    }
}