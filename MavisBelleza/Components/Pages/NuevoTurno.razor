@page "/turnos/nuevo"
@using Microsoft.EntityFrameworkCore
@using MavisBelleza.Data
@using MavisBelleza.Models
@using MavisBelleza.Components.Components_Reutilizables
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Nuevo Turno</PageTitle>

<main class="container my-4" style="max-width: 600px;">
    <header class="mb-4">
        <h2>Agendar Nuevo Turno</h2>
    </header>

    @if (clientes == null)
    {
        <p>Cargando clientes...</p>
    }
    else
    {
        <TurnoForm Turno="nuevoTurno" Clientes="clientes" OnValidSubmit="GuardarTurno" />
    }
</main>

@code {
    private TurnosModels nuevoTurno = new();
    private List<ClientesModels> clientes = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        clientes = await context.Clientes.ToListAsync();
    }

    private async Task GuardarTurno()
    {
        using var context = DbFactory.CreateDbContext();
        context.Turnos.Add(nuevoTurno);
        await context.SaveChangesAsync();

        // JS Interop ejecutando la alerta global
        await JS.InvokeVoidAsync("mostrarAlerta", "¡Turno creado exitosamente!");

        // Navegación programática hacia el listado
        Navigation.NavigateTo("/turnos");
    }
}