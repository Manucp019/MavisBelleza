@page "/turnos/nuevo"
@using MavisBelleza.Models
@using MavisBelleza.Components.Components_Reutilizables
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Nuevo Turno - Mavis Belleza</PageTitle>

<main class="container my-5" style="max-width: 520px;">
    <div class="card card-spa p-4 p-md-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #2f3e46;">Agendar Turno</h2>
            <p class="text-muted small">Completa los datos de la clienta y el tratamiento</p>
        </div>

        <TurnoForm Turno="nuevoTurno" OnValidSubmit="GuardarTurno" />
    </div>
</main>

@code {
    private TurnosModels nuevoTurno = new();

    private async Task GuardarTurno()
    {
        await JS.InvokeVoidAsync("mostrarAlerta", "¡Turno agendado con éxito!");
        Navigation.NavigateTo("/turnos");
    }
}