@page "/"

<PageTitle>Mavis Belleza - Especialidad en Cejas y Pestañas</PageTitle>

<!-- HERO: CARRUSEL DE TRABAJOS -->
<section class="container mb-5">
    <div class="py-4 px-3 rounded-5 shadow-sm hero-banner text-center">
        <h1 class="visually-hidden">Mavis Belleza</h1>

        <div class="mb-4">
            <Carrusel Fotos="fotosTrabajos" Titulo="Galería de trabajos" Intervalo="4" AnchoMaximo="600px" Proporcion="4 / 3" />
        </div>

        <p class="lead mb-0 fs-4 texto-hero">Especialidad en Cejas y Pestañas — Resaltá tu mirada de forma natural</p>
    </div>
</section>

<!-- SECCIÓN DE SERVICIOS -->
<section id="tratamientos" class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="title-marca subrayado-dorado">Nuestros Tratamientos</h2>
        <p class="text-muted">Servicios personalizados con productos de primera calidad para cuidar tu piel y mirada</p>
    </div>

    <div class="row g-4">
        <!-- Servicio 1: Lifting de Pestañas -->
        <div class="col-12 col-md-4">
            <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-servicio">
                <img src="img/lifting.jpg"
                     class="card-img-top card-servicio-img"
                     alt="Lifting de Pestañas" />
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge badge-servicio">⏱️ 1h 30m</span>
                        <span class="fs-5 fw-bold price-text">$30.000</span>
                    </div>
                    <h3 class="card-title fs-4 fw-bold title-marca">Lifting de Pestañas</h3>
                    <p class="card-text text-muted small flex-grow-1">
                        Tratamiento que arquea y da curvatura natural a tus pestañas desde la raíz. Incluye nutrición profunda con botox/keratina para fortalecer el pelo y tinte para dar un efecto de rímel natural.
                    </p>
                    <a href="turnos/nuevo/1" class="btn btn-spa w-100 mt-3">
                        Reservar Lifting
                    </a>
                </div>
            </article>
        </div>

        <!-- Servicio 2: Laminado de Cejas -->
        <div class="col-12 col-md-4">
            <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-servicio">
                <img src="img/laminado.jpg"
                     class="card-img-top card-servicio-img"
                     alt="Laminado de Cejas" />
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge badge-servicio">⏱️ 1 hora</span>
                        <span class="fs-5 fw-bold price-text">$30.000</span>
                    </div>
                    <h3 class="card-title fs-4 fw-bold title-marca">Laminado de Cejas</h3>
                    <p class="card-text text-muted small flex-grow-1">
                        Diseñado para peinar, fijar y alinear los vellos rebeldes o desordenados de las cejas, dando una sensación de mayor volumen y definición. Incluye perfilado e hidratación.
                    </p>
                    <a href="turnos/nuevo/2" class="btn btn-spa w-100 mt-3">
                        Reservar Laminado
                    </a>
                </div>
            </article>
        </div>

        <!-- Servicio 3: Perfilado de Cejas -->
        <div class="col-12 col-md-4">
            <article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-servicio">
                <img src="img/perfilado.jpg"
                     class="card-img-top card-servicio-img"
                     alt="Perfilado de Cejas" />
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge badge-servicio">⏱️ 30 min</span>
                        <span class="fs-5 fw-bold price-text">$15.000</span>
                    </div>
                    <h3 class="card-title fs-4 fw-bold title-marca">Perfilado de Cejas</h3>
                    <p class="card-text text-muted small flex-grow-1">
                        Diseño de cejas personalizado según la morfología de tu rostro (visagismo). Remoción precisa del exceso de vello mediante pinza o cera suave para un acabado perfecto.
                    </p>
                    <a href="turnos/nuevo/3" class="btn btn-spa w-100 mt-3">
                        Reservar Perfilado
                    </a>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- COMBOS -->
<section class="container mb-5">
    <div class="text-center mb-4">
        <h2 class="title-marca subrayado-dorado">Combos</h2>
        <p class="text-muted">Combiná tratamientos y ahorrá</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <article class="card h-100 border-0 shadow-sm rounded-4 card-servicio">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge badge-dorado">Ahorrás $5.000</span>
                        <span class="fs-4 fw-bold price-text">$40.000</span>
                    </div>
                    <h3 class="card-title fs-4 fw-bold title-marca">Lifting + Perfilado</h3>
                    <p class="card-text text-muted small flex-grow-1">
                        Lifting de pestañas con nutrición y tinte, más perfilado de cejas personalizado. ⏱️  1 h 30 min
                    </p>
                    <a href="turnos/nuevo/4" class="btn btn-spa w-100 mt-3">Reservar combo</a>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-lg-5">
            <article class="card h-100 border-0 shadow-sm rounded-4 card-servicio">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge badge-dorado">Ahorrás $5.000</span>
                        <span class="fs-4 fw-bold price-text">$55.000</span>
                    </div>
                    <h3 class="card-title fs-4 fw-bold title-marca">Laminado + Lifting</h3>
                    <p class="card-text text-muted small flex-grow-1">
                        Laminado de cejas con hidratación, más lifting de pestañas con nutrición y tinte. ⏱️ 1 h 30 min
                    </p>
                    <a href="turnos/nuevo/5" class="btn btn-spa w-100 mt-3">Reservar combo</a>
                </div>
            </article>
        </div>
    </div>
</section>



<!-- UBICACIÓN, HORARIOS & MAPA -->
<section class="container my-5 py-4">
    <div class="row g-4 align-items-center card-spa p-4 p-md-5">
        <div class="col-12 col-lg-5">
            <h2 class="mb-4 title-marca">Visitanos en nuestro Studio</h2>

            <div class="d-flex align-items-start mb-3">
                <div class="fs-4 me-3">📍</div>
                <div>
                    <h3 class="fw-bold mb-1 fs-6 title-marca">Dirección</h3>
                    <p class="text-muted mb-0">
                        Almafuerte 284, Glew, Buenos Aires ·
                        <a href="https://www.google.com/maps/dir/?api=1&destination=Almafuerte%20284,%20Glew,%20Buenos%20Aires" target="_blank" rel="noopener">Cómo llegar</a>
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-start mb-3">
                <div class="fs-4 me-3">🕒</div>
                <div>
                    <h3 class="fw-bold mb-1 fs-6 title-marca">Horarios de Atención</h3>
                    <p class="text-muted mb-0">Lunes a Sábados: 09:00 hs - 18:30 hs</p>
                </div>
            </div>

            <div class="d-flex align-items-start mb-4">
                <div class="fs-4 me-3">📲</div>
                <div>
                    <h3 class="fw-bold mb-1 fs-6 title-marca">Consultas y Turnos</h3>
                    <p class="text-muted mb-0">+54 9 11 1234-5678</p>
                </div>
            </div>

            <a href="https://wa.me/5491112345678?text=Hola!%20Quisiera%20hacer%20una%20consulta"
               target="_blank"
               class="btn btn-success w-100 py-3 rounded-pill fw-bold d-flex justify-content-center align-items-center gap-2 shadow-sm">
                Enviar Mensaje por WhatsApp
            </a>
        </div>

        <div class="col-12 col-lg-7">
            <div class="rounded-4 overflow-hidden shadow-sm map-container">
                <iframe title="Ubicación de Mavis Belleza en Google Maps" src="https://maps.google.com/maps?q=Almafuerte%20284,%20Glew,%20Buenos%20Aires,%20Argentina&z=16&output=embed"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</section>

@code {
    // Fotos del carrusel "Mis Trabajos" (están en wwwroot/img/)
    private readonly List<Carrusel.FotoCarrusel> fotosTrabajos = new()
    {
        new("img/lifting1.jpg", "Lifting de pestañas"),
        new("img/lifting2.jpeg", "Lifting de pestañas"),
        new("img/lifting3.jpeg", "Lifting de pestañas"),
        new("img/lifting4.JPEG", "Lifting de pestañas"),
        new("img/lifting6.jpg", "Lifting de pestañas"),
    };
}