@inherits LayoutComponentBase

<div class="page d-flex flex-column min-vh-100">
    <!-- Encabezado con la navegación principal -->
    <header class="w-100 sticky-top">
        <NavMenu />
    </header>

    <!-- Contenido de cada página -->
    <main id="contenido" class="flex-grow-1 py-4">
        @Body
    </main>

    <!-- Pie de página -->
    <footer class="pie-pagina text-center py-3 small">
        <p class="mb-0">&copy; @DateTime.Now.Year Mavis Belleza — Especialidad en Cejas y Pestañas</p>
    </footer>

    <!-- Notificaciones (toasts) del usuario actual -->
    <Toasts />
</div>

<div id="blazor-error-ui" role="alert">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">✕</a>
</div>
