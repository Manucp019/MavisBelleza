@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- Barra superior limpia y alineada con la paleta de colores -->
        <header class="top-row px-4 d-flex justify-content-between align-items-center shadow-sm">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-flower1 fs-5" style="color: #2d5a44;"></i>
                <span class="fw-semibold" style="color: #1b382b; font-size: 0.95rem;">
                    Gestión de Turnos & Estética
                </span>
            </div>

            <a href="https://github.com" target="_blank" class="btn btn-sm d-flex align-items-center gap-2 px-3 py-1" style="border: 1px solid #83a390; color: #1b382b; background-color: #f4f7f5; border-radius: 20px; font-weight: 500;">
                <i class="bi bi-github"></i>
                <span>Repositorio</span>
            </a>
        </header>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>