@inherits LayoutComponentBase

<div class="page d-flex flex-column min-vh-100">
    <!-- Menú de Navegación Superior -->
    <header class="w-100 sticky-top">
        <NavMenu />
    </header>

    <!-- Contenido Principal de las Páginas -->
    <main class="flex-grow-1 py-4">
        @Body
    </main>

    <!-- Pie de Página Opcional -->
    <footer class="text-center py-3 text-muted small border-top bg-white">
        &copy; @DateTime.Now.Year Mavis Belleza — Especialidad en Cejas y Pestañas
    </footer>
</div>