@using MavisBelleza.Models

<div class="card turno-card h-100 p-3 shadow-sm border-0 rounded-4">
    <div class="card-body d-flex flex-column justify-content-between">
        <div>
            <!-- Header: Nombre y Estado -->
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h5 class="fw-bold mb-0" style="color: #2f3e46;">
                        👤 @Turno.NombreCliente @Turno.ApellidoCliente
                    </h5>
                    <span class="badge badge-servicio mt-2">@Turno.Servicio</span>
                </div>
                <span class="badge rounded-pill bg-success px-3 py-1">@Turno.Estado</span>
            </div>

            <hr class="my-3" style="color: #a3b18a;" />

            <!-- Datos de contacto -->
            <div class="mb-3 small">
                <div class="mb-1 text-muted">
                    <strong>📞 Teléfono:</strong>
                    <a href="https://wa.me/549@(Turno.Telefono.Replace(" ", "").Replace("-", ""))" target="_blank" class="text-decoration-none fw-semibold" style="color: #3a5a40;">
                        @Turno.Telefono 💬
                    </a>
                </div>
                <div class="text-muted text-truncate">
                    <strong>✉️ Email:</strong> @Turno.Email
                </div>
            </div>

            <!-- Detalles del turno y pago -->
            <div class="p-3 rounded-4 mb-3" style="background-color: #f4f6f0;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small">⏰ Horario:</span>
                    <span class="fw-bold" style="color: #3a5a40;">@Turno.Horario hs</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small">💳 Pago:</span>
                    <span class="fw-semibold text-dark">@Turno.MetodoPago</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">💵 Precio:</span>
                    <span class="fs-6 fw-bold" style="color: #3a5a40;">$@Turno.Precio.ToString("N0")</span>
                </div>
            </div>
        </div>

        <!-- Botón de cancelación -->
        <button class="btn btn-outline-danger-spa w-100 py-2 mt-2" @onclick="() => OnDelete.InvokeAsync(Turno.Id)">
            Cancelar Turno
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TurnosModels Turno { get; set; } = new();

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }
}