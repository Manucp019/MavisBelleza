@* Tarjeta de un turno. No accede a la base: avisa al padre con EventCallbacks. *@
<article class="turno-card @(EsPasado ? "turno-pasado" : "") @(Turno.Estado == EstadosTurno.Cancelado ? "turno-cancelado" : "")">
    <header class="turno-header">
        <div class="turno-fecha" aria-label="Fecha del turno">
            <span class="turno-dia">@Turno.Fecha.Day</span>
            <span class="turno-mes">@Turno.Fecha.ToString("MMM", Cultura).TrimEnd('.')</span>
        </div>
        <div class="flex-grow-1 min-w-0">
            <h3 class="turno-cliente text-truncate">
                @if (Turno.Cliente is not null)
                {
                    <a href="clientes/@Turno.ClienteId" title="Ver ficha del cliente">@Turno.Cliente.NombreCompleto</a>
                }
            </h3>
            <span class="turno-servicio">@Turno.Servicio?.Nombre</span>
        </div>
        <EstadoBadge Estado="@Turno.Estado" />
    </header>

    <dl class="turno-detalle">
        <div>
            <dt>⏰ Horario</dt>
            <dd><time datetime="@($"{Turno.Fecha:yyyy-MM-dd}T{Turno.Horario}")">@Turno.Fecha.ToString("ddd dd/MM", Cultura) · @Turno.Horario hs</time></dd>
        </div>
        <div>
            <dt>💳 Pago</dt>
            <dd>@Turno.MetodoPago</dd>
        </div>
        <div>
            <dt>💵 Precio</dt>
            <dd class="turno-precio">$@Turno.Precio.ToString("N0", Cultura)</dd>
        </div>
        @if (Turno.Cliente is not null)
        {
            <div>
                <dt>📞 Contacto</dt>
                <dd>
                    <a href="@LinkWhatsApp" target="_blank" rel="noopener" class="turno-whatsapp">@Turno.Cliente.Telefono 💬</a>
                </dd>
            </div>
        }
    </dl>

    @if (!string.IsNullOrWhiteSpace(Turno.Notas))
    {
        <p class="turno-notas">📝 @Turno.Notas</p>
    }

    <footer class="turno-acciones">
        <a href="turnos/editar/@Turno.Id" class="btn btn-sm btn-outline-secondary rounded-pill">✏️ Editar</a>

        @if (Turno.Estado is EstadosTurno.Pendiente)
        {
            <button class="btn btn-sm btn-outline-success rounded-pill" @onclick="() => CambiarEstado(EstadosTurno.Confirmado)">✔ Confirmar</button>
        }
        @if (Turno.Estado is EstadosTurno.Confirmado && EsPasado)
        {
            <button class="btn btn-sm btn-outline-info rounded-pill" @onclick="() => CambiarEstado(EstadosTurno.Realizado)">★ Realizado</button>
        }
        @if (Turno.Estado is EstadosTurno.Pendiente or EstadosTurno.Confirmado)
        {
            <button class="btn btn-sm btn-dorado-outline rounded-pill" @onclick="() => CambiarEstado(EstadosTurno.Cancelado)">Cancelar</button>
        }

        <button class="btn btn-sm btn-outline-danger rounded-pill ms-auto" title="Eliminar turno" aria-label="Eliminar turno"
                @onclick="() => OnEliminar.InvokeAsync(Turno)">
            🗑
        </button>
    </footer>
</article>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = new("es-AR");

    [Parameter, EditorRequired] public Turno Turno { get; set; } = default!;

    /// <summary>Se dispara al tocar el tachito; el padre muestra el modal de confirmación.</summary>
    [Parameter] public EventCallback<Turno> OnEliminar { get; set; }

    /// <summary>Se dispara al cambiar el estado (Confirmar, Realizado, Cancelar).</summary>
    [Parameter] public EventCallback<CambioEstadoTurno> OnCambiarEstado { get; set; }

    private bool EsPasado => Turno.Fecha.Date < DateTime.Today;

    private string LinkWhatsApp
    {
        get
        {
            var numero = new string((Turno.Cliente?.Telefono ?? "").Where(char.IsDigit).ToArray());
            return $"https://wa.me/549{numero}";
        }
    }

    private Task CambiarEstado(string nuevo) => OnCambiarEstado.InvokeAsync(new CambioEstadoTurno(Turno, nuevo));
}
