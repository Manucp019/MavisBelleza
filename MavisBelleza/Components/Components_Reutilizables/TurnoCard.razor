@using MavisBelleza.Models

<div class="card turno-card h-100 shadow-sm border-0 overflow-hidden" style="border-radius: 20px; background-color: #ffffff;">
    <!-- Imagen dinámica mapeada según el servicio -->
    <img src="@ObtenerImagenServicio(Turno.Servicio)" class="card-img-top" alt="@Turno.Servicio" style="height: 160px; object-fit: cover;" />

    <div class="card-body p-4 d-flex flex-column justify-content-between">
        <div>
            <!-- Encabezado con Badges de Servicio y Estado -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge rounded-pill px-3 py-2" style="background-color: #a3b18a; color: #2f3e46; font-weight: 600;">
                    @Turno.Servicio
                </span>
                <EstadoBadge Estado="@Turno.Estado" />
            </div>

            <!-- Nombre y Apellido del Cliente -->
            <h5 class="card-title fw-bold mb-1" style="color: #2f3e46;">
                @Turno.NombreCliente @Turno.ApellidoCliente
            </h5>

            <!-- Precio del Servicio -->
            @if (Turno.Precio > 0)
            {
                <p class="fw-bold mb-2" style="color: #3a5a40; font-size: 1.1rem;">
                    $@Turno.Precio.ToString("N0")
                </p>
            }

            <!-- Fecha y Hora Formateadas -->
            <p class="card-text text-muted small mb-3">
                <i class="bi bi-calendar3 me-1" style="color: #52796f;"></i> @Turno.Fecha.ToString("dd/MM/yyyy")
                <span class="ms-2"><i class="bi bi-clock me-1" style="color: #52796f;"></i> @Turno.Hora.ToString(@"hh\:mm") hs</span>
            </p>
        </div>

        <!-- Botón de Acción -->
        <button class="btn btn-outline-danger btn-sm w-100 rounded-pill py-2 mt-2"
                style="border-color: #e63946; color: #e63946; font-weight: 500;"
                @onclick="() => OnDelete.InvokeAsync(Turno.Id)">
            Cancelar Turno
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TurnosModels Turno { get; set; } = default!;
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private string ObtenerImagenServicio(string servicio) => servicio switch
    {
        "Lifting de Pestañas" => "/images/lifting.jpg",
        "Laminado de Cejas" => "/images/laminado.jpg",
        "Perfilado de Cejas" => "/images/perfilado.jpg",
        _ => "/images/lifting.jpg"
    };
}