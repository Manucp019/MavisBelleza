@if (Mostrar)
{
    <div class="modal fade show d-block backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titulo</h5>
                </div>
                <div class="modal-body"><p>@Mensaje</p></div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="Confirmar">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public string Titulo { get; set; } = "Confirmación";
    [Parameter] public string Mensaje { get; set; } = "¿Desea eliminar el turno?";
    [Parameter] public EventCallback<bool> OnResponse { get; set; }

    private Task Cancelar() => OnResponse.InvokeAsync(false);
    private Task Confirmar() => OnResponse.InvokeAsync(true);
}