<span class="badge @ObtenerClaseBadge(Estado)">@Estado</span>

@code {
    [Parameter] public string Estado { get; set; } = "Pendiente";

    private string ObtenerClaseBadge(string estado) => estado switch
    {
        "Confirmado" => "bg-success",
        "Pendiente" => "bg-warning text-dark",
        "Cancelado" => "bg-danger",
        _ => "bg-secondary"
    };
}