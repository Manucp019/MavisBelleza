@* Muestra el estado de un turno con el color correspondiente *@
<span class="badge rounded-pill px-3 py-1 @Clase" title="Estado: @Estado">@Icono @Estado</span>

@code {
    [Parameter, EditorRequired] public string Estado { get; set; } = EstadosTurno.Pendiente;

    private string Clase => Estado switch
    {
        EstadosTurno.Confirmado => "bg-success",
        EstadosTurno.Pendiente => "badge-dorado",
        EstadosTurno.Realizado => "bg-info text-dark",
        EstadosTurno.Cancelado => "bg-danger",
        _ => "bg-secondary"
    };

    private string Icono => Estado switch
    {
        EstadosTurno.Confirmado => "✔",
        EstadosTurno.Pendiente => "⏳",
        EstadosTurno.Realizado => "★",
        EstadosTurno.Cancelado => "✖",
        _ => ""
    };
}
