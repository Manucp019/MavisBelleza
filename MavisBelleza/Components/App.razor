    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amatic+SC:wght@400;700&family=Quicksand:wght@400;500;600;700&display=swap" />

    <!-- 1) Bootstrap 5 -->
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <!-- 2) Estilos globales de la app (paleta, botones, inputs) -->
    <link rel="stylesheet" href="app.css?v=5" />
    <link rel="stylesheet" href="MavisBelleza.styles.css?v=5" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="img/apple-touch-icon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <!-- Interactividad global: todas las páginas corren en modo Interactive Server -->
