<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Mavis Belleza - Studio especializado en cejas y pestañas. Reservá tu turno online." />
    <base href="/" />

    <meta name="theme-color" content="#141414" />

    <!-- Tipografías: Amatic SC (manuscrita, como las letras del logo) y Quicksand (texto) -->
